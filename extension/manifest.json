{
  "manifest_version": 3,
  "name": "Ekachitta: YouTube Focus Filter",
  "version": "1.0",
  "description": "A Chromium extension to disable comments, shorts, and filter YouTube content based on user-defined keywords & more.",
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/ekachitta-16.png" 
  },
  "icons": {
    "16": "icons/ekachitta-16.png",
    "48": "icons/ekachitta-48.png",
    "128": "icons/ekachitta-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  }
}